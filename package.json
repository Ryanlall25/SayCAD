{
  "name": "saycad",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Speak it, see it, print it \u2014 a conversational CAD. Crown Studio: AI-assisted crown design on a phone.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:artifact": "tsc --noEmit && SAYCAD_BASE=./ vite build --outDir dist-artifact",
    "preview": "vite preview",
    "server": "node server/index.mjs",
    "start": "npm run build && npm run build:module && node server/index.mjs",
    "test": "vitest run",
    "e2e": "npm run build && npm run build:artifact && node dev/e2e.mjs",
    "train": "vite-node scripts/train.ts --",
    "synthetic-cases": "vite-node scripts/synthetic-cases.ts --",
    "import-library": "vite-node scripts/import-library.ts --",
    "e2e:newcase": "node dev/e2e-newcase.mjs",
    "crown": "vite-node scripts/crown.ts --",
    "build:module": "vite build --ssr src/module/index.ts --outDir dist-module --emptyOutDir",
    "e2e:embed": "node dev/e2e-embed.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "three": "^0.180.0",
    "three-mesh-bvh": "^0.9.16"
  },
  "devDependencies": {
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.4",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^25.0.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "vitest": "^3.2.4"
  }
}
